# Production app URL — used for /integrate examples and embed copy when set (defaults to https://ohanahandshake.com).
# VITE_PUBLIC_APP_URL=https://ohanahandshake.com

# Optional: public GitHub repo URL (defaults to https://github.com/ecjay12/ohana-protocol if unset).
# VITE_GITHUB_REPO_URL=https://github.com/your-org/ohana-protocol

# Optional: Gitcoin Passport API key (server-side only).
# PASSPORT_API_KEY=

# Optional: Allowed origins for embed postMessage (comma-separated).
# VITE_ALLOWED_EMBED_ORIGINS=https://app.example.com

# Optional: LSP Hasura indexer (LUKSO Universal Profile names on leaderboard). Defaults to Sigmacore public endpoint.
# VITE_INDEXER_URL=https://indexer.sigmacore.io/v1/graphql
